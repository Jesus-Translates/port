# --- Auth gate ---
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-long-random-string

# Comma-separated allowed usernames (case-insensitive) and the shared password.
VALID_USERS=Kelly,Jenni,Robert
SHARED_PASSWORD=change-me

# --- Cloudflare Turnstile (bot protection on login) ---
# Create a widget at https://dash.cloudflare.com -> Turnstile.
# The values below are Cloudflare's official "always pass" TEST keys — swap for real ones.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Database (auto-provisioned by the Neon integration on Vercel) ---
# vercel env pull .env.local  fills this in.
DATABASE_URL=

# --- AI ---
# Model served through the Vercel AI Gateway. On Vercel, auth is automatic (OIDC).
# For local dev either `vercel env pull` (OIDC token) or set AI_GATEWAY_API_KEY.
AI_MODEL=openai/gpt-5.6-luna
# AI_GATEWAY_API_KEY=
